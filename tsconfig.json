{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"types": ["node", "mocha"],
		"paths": {
			"*": ["./node_modules/@types/*"]
		}
	},
	"include": ["src"]
}
